# ---------------------------------------------------------------------------
# Hefesto — staging environment template (docker-compose.staging.yml, ADR 0026).
#
# Copy to /srv/hefesto/.env.staging on the production host (mode 0600) and
# fill in every blank. Use values of its own, never production's: a staging
# token must not work against production, and staging must not write to the
# production bucket. No secret has a default here either.
# Comments must stay on their own lines: the checks match `KEY=` exactly.
# ---------------------------------------------------------------------------

# --- image -------------------------------------------------------------------
HEFESTO_IMAGE=ghcr.io/jaelricco/hefesto

# --- database (the staging project's own Postgres) ---------------------------
POSTGRES_USER=hefesto
POSTGRES_DB=hefesto_staging
# Hex, because it also goes into DATABASE_URL, where / or + would break the
# URL. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# postgres://hefesto:<POSTGRES_PASSWORD>@postgres:5432/hefesto_staging?sslmode=disable
DATABASE_URL=
HEFESTO_DB_MAX_CONNS=10
HEFESTO_DB_MIN_CONNS=1

# --- runtime -----------------------------------------------------------------
HEFESTO_LOG_LEVEL=info
HEFESTO_SHUTDOWN_GRACE=15s

# --- auth --------------------------------------------------------------------
# Its own key, never production's. Generate: openssl rand -base64 48
HEFESTO_JWT_SIGNING_KEY=
HEFESTO_JWT_ISSUER=hefesto-staging
HEFESTO_ACCESS_TOKEN_TTL=15m
HEFESTO_REFRESH_TOKEN_TTL=2160h
HEFESTO_ARGON2_MEMORY_KIB=65536
HEFESTO_ARGON2_ITERATIONS=3
HEFESTO_ARGON2_PARALLELISM=2
HEFESTO_ACCOUNT_DELETION_GRACE=720h
HEFESTO_APPLE_CLIENT_ID=fit.hefesto.ios
HEFESTO_TRUST_PROXY_HEADERS=true
HEFESTO_AUTH_PER_MINUTE=10

# --- object storage (its own bucket) -----------------------------------------
HEFESTO_S3_ENDPOINT=
HEFESTO_S3_REGION=
HEFESTO_S3_BUCKET=hefesto-media-staging
HEFESTO_S3_ACCESS_KEY=
HEFESTO_S3_SECRET_KEY=
HEFESTO_S3_USE_PATH_STYLE=false
HEFESTO_S3_PRESIGN_TTL=15m
