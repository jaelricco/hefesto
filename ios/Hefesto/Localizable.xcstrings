    "0 is no pain, 10 the worst imaginable. Optional: your plan adapts the load of the region to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ist kein Schmerz, 10 der schlimmste vorstellbare. Freiwillig: Dein Plan passt die Belastung der Region daran an."
          }
        }
      }
    },
    "0 is no pain, 10 the worst you can imagine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ist kein Schmerz, 10 der stärkste vorstellbare."
