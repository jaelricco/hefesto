# Production Postgres: the official image plus pgBackRest, for continuous WAL
# archiving and point-in-time recovery (ADR 0026). Built on the server by
# Compose (docker-compose.prod.yml); with this file unchanged the build is
# fully cached, the image id stays the same, and a deploy does not restart
# the database.
FROM postgres:16-alpine

# Alpine's community package (2.55 on Alpine 3.22). Not pinned: the base
# image follows Alpine releases, and pgBackRest keeps its repository format
# compatible across versions.
RUN apk add --no-cache pgbackrest jq \
    && mkdir -p /tmp/pgbackrest \
    && chown postgres:postgres /tmp/pgbackrest
