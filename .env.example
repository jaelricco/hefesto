# ---------------------------------------------------------------------------
# Lodestar — example environment. Copy to .env and fill in.
# Every variable the API reads is listed here. No defaults contain secrets.
# ---------------------------------------------------------------------------

# --- runtime -----------------------------------------------------------------
LODESTAR_ENV=dev                  # dev | staging | prod
LODESTAR_HTTP_ADDR=:8080          # listen address of the API
LODESTAR_LOG_LEVEL=debug          # debug | info | warn | error
LODESTAR_LOG_FORMAT=text          # text | json  (use json in prod)
LODESTAR_SHUTDOWN_GRACE=15s

# --- database ----------------------------------------------------------------
# Compose sets these for the api/migrate containers; override for local runs.
POSTGRES_USER=lodestar
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=lodestar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://lodestar:CHANGE_ME_LOCAL_ONLY@postgres:5432/lodestar?sslmode=disable
LODESTAR_DB_MAX_CONNS=10
LODESTAR_DB_MIN_CONNS=2

# goose reads these separately
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=db/migrations

# --- auth --------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
LODESTAR_JWT_SIGNING_KEY=
LODESTAR_JWT_ISSUER=lodestar
LODESTAR_ACCESS_TOKEN_TTL=15m
LODESTAR_REFRESH_TOKEN_TTL=2160h   # 90 days
LODESTAR_ARGON2_MEMORY_KIB=65536
LODESTAR_ARGON2_ITERATIONS=3
LODESTAR_ARGON2_PARALLELISM=2

# Sign in with Apple
LODESTAR_APPLE_TEAM_ID=
LODESTAR_APPLE_CLIENT_ID=ch.riske.lodestar
LODESTAR_APPLE_KEY_ID=
LODESTAR_APPLE_PRIVATE_KEY_PATH=

# --- object storage (MinIO in dev, S3-compatible in prod) --------------------
LODESTAR_S3_ENDPOINT=http://minio:9000
LODESTAR_S3_REGION=us-east-1
LODESTAR_S3_BUCKET=lodestar-media
LODESTAR_S3_ACCESS_KEY=lodestar
LODESTAR_S3_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
LODESTAR_S3_USE_PATH_STYLE=true
LODESTAR_S3_PRESIGN_TTL=15m

# --- mail (mailpit in dev) ---------------------------------------------------
LODESTAR_SMTP_HOST=mailpit
LODESTAR_SMTP_PORT=1025
LODESTAR_SMTP_USERNAME=
LODESTAR_SMTP_PASSWORD=
LODESTAR_MAIL_FROM=no-reply@lodestar.local

# --- content -----------------------------------------------------------------
LODESTAR_CONTENT_DIR=./content
