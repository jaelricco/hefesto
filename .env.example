# ---------------------------------------------------------------------------
# Hefesto — example environment. Copy to .env and fill in.
# Every variable the API reads is listed here. No defaults contain secrets.
# ---------------------------------------------------------------------------

# --- runtime -----------------------------------------------------------------
HEFESTO_ENV=dev                  # dev | staging | prod
HEFESTO_HTTP_ADDR=:8080          # listen address of the API
HEFESTO_LOG_LEVEL=debug          # debug | info | warn | error
HEFESTO_LOG_FORMAT=text          # text | json  (use json in prod)
HEFESTO_SHUTDOWN_GRACE=15s

# --- database ----------------------------------------------------------------
# Compose sets these for the api/migrate containers; override for local runs.
POSTGRES_USER=hefesto
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=hefesto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://hefesto:CHANGE_ME_LOCAL_ONLY@postgres:5432/hefesto?sslmode=disable
HEFESTO_DB_MAX_CONNS=10
HEFESTO_DB_MIN_CONNS=2

# goose reads these separately
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=db/migrations

# --- auth --------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
HEFESTO_JWT_SIGNING_KEY=
HEFESTO_JWT_ISSUER=hefesto
HEFESTO_ACCESS_TOKEN_TTL=15m
HEFESTO_REFRESH_TOKEN_TTL=2160h   # 90 days
HEFESTO_ARGON2_MEMORY_KIB=65536
HEFESTO_ARGON2_ITERATIONS=3
HEFESTO_ARGON2_PARALLELISM=2
HEFESTO_ACCOUNT_DELETION_GRACE=720h  # 30 days to change your mind
# Take the client address from X-Forwarded-For. Only behind a proxy you run.
HEFESTO_TRUST_PROXY_HEADERS=false

# Sign in with Apple. CLIENT_ID is the accepted token audience; comma-separate
# several (app bundle id, web service id). Empty disables Apple sign-in.
HEFESTO_APPLE_TEAM_ID=
HEFESTO_APPLE_CLIENT_ID=fit.hefesto.ios
HEFESTO_APPLE_KEY_ID=
HEFESTO_APPLE_PRIVATE_KEY_PATH=

# --- object storage (MinIO in dev, S3-compatible in prod) --------------------
HEFESTO_S3_ENDPOINT=http://minio:9000
# The address a phone or simulator uploads to; presigned URLs carry this host.
HEFESTO_S3_PUBLIC_ENDPOINT=http://localhost:9000
HEFESTO_S3_REGION=us-east-1
HEFESTO_S3_BUCKET=hefesto-media
HEFESTO_S3_ACCESS_KEY=hefesto
HEFESTO_S3_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
HEFESTO_S3_USE_PATH_STYLE=true
HEFESTO_S3_PRESIGN_TTL=15m

# --- mail (mailpit in dev) ---------------------------------------------------
HEFESTO_SMTP_HOST=mailpit
HEFESTO_SMTP_PORT=1025
HEFESTO_SMTP_USERNAME=
HEFESTO_SMTP_PASSWORD=
HEFESTO_MAIL_FROM=no-reply@hefesto.fit

# --- content -----------------------------------------------------------------
HEFESTO_CONTENT_DIR=./content
