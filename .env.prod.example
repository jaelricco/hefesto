# ---------------------------------------------------------------------------
# Hefesto — production environment template.
#
# Copy to /srv/hefesto/.env.prod on the server (mode 0600) and fill in every
# blank. Blanks are deliberate: no secret has a default, and
# docker-compose.prod.yml fails loudly on any that is missing. This file never
# holds a real value; `make deploy-check` and CI fill the blanks with
# placeholders only to type-check the compose file.
# Comments must stay on their own lines: the checks match `KEY=` exactly.
# ---------------------------------------------------------------------------

# --- image -------------------------------------------------------------------
HEFESTO_IMAGE=ghcr.io/jaelricco/hefesto

# --- domains and TLS (Caddy) -------------------------------------------------
HEFESTO_API_DOMAIN=api.hefesto.fit
HEFESTO_SITE_DOMAIN=hefesto.fit
HEFESTO_SITE_DOMAIN_ALT=hefesto.ch
# Caddy also serves the staging API (docker-compose.staging.yml) here.
HEFESTO_STAGING_API_DOMAIN=api-staging.hefesto.fit
# Let's Encrypt account contact.
HEFESTO_ACME_EMAIL=

# --- database ----------------------------------------------------------------
POSTGRES_USER=hefesto
POSTGRES_DB=hefesto
# Hex, because it also goes into DATABASE_URL, where / or + would break the
# URL. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# postgres://hefesto:<POSTGRES_PASSWORD>@postgres:5432/hefesto?sslmode=disable
DATABASE_URL=
HEFESTO_DB_MAX_CONNS=20
HEFESTO_DB_MIN_CONNS=2

# --- runtime -----------------------------------------------------------------
HEFESTO_LOG_LEVEL=info
HEFESTO_SHUTDOWN_GRACE=15s

# --- auth --------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
HEFESTO_JWT_SIGNING_KEY=
HEFESTO_JWT_ISSUER=hefesto
HEFESTO_ACCESS_TOKEN_TTL=15m
HEFESTO_REFRESH_TOKEN_TTL=2160h
HEFESTO_ARGON2_MEMORY_KIB=65536
HEFESTO_ARGON2_ITERATIONS=3
HEFESTO_ARGON2_PARALLELISM=2
HEFESTO_ACCOUNT_DELETION_GRACE=720h
# Accepted Sign in with Apple audiences, comma-separated.
HEFESTO_APPLE_CLIENT_ID=fit.hefesto.ios
# Caddy is the only thing in front of the API, so its X-Forwarded-For is trusted.
HEFESTO_TRUST_PROXY_HEADERS=true
# Sign-in, registration and refresh attempts per client address per minute.
HEFESTO_AUTH_PER_MINUTE=10

# --- object storage (Hetzner Object Storage) ---------------------------------
HEFESTO_S3_ENDPOINT=
HEFESTO_S3_REGION=
HEFESTO_S3_BUCKET=hefesto-media
HEFESTO_S3_ACCESS_KEY=
HEFESTO_S3_SECRET_KEY=
HEFESTO_S3_USE_PATH_STYLE=false
HEFESTO_S3_PRESIGN_TTL=15m

# --- backups (sidecar) -------------------------------------------------------
HEFESTO_BACKUP_ENDPOINT=
HEFESTO_BACKUP_BUCKET=
HEFESTO_BACKUP_ACCESS_KEY=
HEFESTO_BACKUP_SECRET_KEY=
HEFESTO_BACKUP_INTERVAL_S=86400
HEFESTO_BACKUP_RETAIN_DAYS=30

# --- point-in-time recovery (pgBackRest, ADR 0026) ---------------------------
# A bucket of its own, with credentials that can write only to it. The
# endpoint is a host name without scheme or path (fsn1.your-objectstorage.com).
HEFESTO_PITR_S3_ENDPOINT=
HEFESTO_PITR_S3_REGION=
HEFESTO_PITR_S3_BUCKET=
HEFESTO_PITR_S3_KEY=
HEFESTO_PITR_S3_KEY_SECRET=
HEFESTO_PITR_S3_URI_STYLE=path
HEFESTO_PITR_S3_PORT=443
HEFESTO_PITR_VERIFY_TLS=y
# Encrypts the repository. Losing it loses every backup: keep a copy off the
# server, in your password manager. Generate: openssl rand -base64 48
HEFESTO_PITR_CIPHER_PASS=
# Full backups kept (one a week), so about this many weeks to recover into.
HEFESTO_PITR_RETENTION_FULL=2
HEFESTO_PITR_INTERVAL_S=86400
HEFESTO_PITR_FULL_EVERY_S=604800
