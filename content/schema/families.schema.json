{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hefesto.fit/schema/families.schema.json",
  "title": "Families (content/families.yaml)",
  "description": "The one family vocabulary shared by skills and exercises.",
  "type": "object",
  "additionalProperties": false,
  "required": ["families"],
  "properties": {
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name"],
        "properties": {
          "slug": { "$ref": "common.schema.json#/$defs/slug" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
