{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hefesto.fit/schema/training/sources.schema.json",
  "title": "Source register (content/training/sources.yaml)",
  "description": "Generated from docs/research/00_sources.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "evidence"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/source_id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
